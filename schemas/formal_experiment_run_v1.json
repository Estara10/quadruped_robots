{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abs-go2-formal-run/v1",
  "title": "ABS-Go2 Formal Experiment Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "variant", "pairing_key", "git", "models", "effective_config", "environment", "scenario", "seeds", "perception", "rates_hz", "thresholds"],
  "properties": {
    "schema_version": {"const": "abs-go2-formal-run/v1"}, "run_id": {"$ref": "#/$defs/id"}, "created_at": {"type": "string", "minLength": 1}, "variant": {"enum": ["paper-faithful", "stabilized", "agile-only"]}, "pairing_key": {"$ref": "#/$defs/sha256"}, "git": {"$ref": "#/$defs/git"}, "models": {"$ref": "#/$defs/models"}, "effective_config": {"$ref": "#/$defs/file_hash"}, "environment": {"$ref": "#/$defs/environment"}, "scenario": {"$ref": "#/$defs/scenario"}, "seeds": {"$ref": "#/$defs/seeds"}, "perception": {"$ref": "#/$defs/perception"}, "rates_hz": {"$ref": "#/$defs/rates"}, "thresholds": {"$ref": "#/$defs/thresholds"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "nonempty": {"type": "string", "minLength": 1},
    "file_hash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "git": {"type": "object", "additionalProperties": false, "required": ["commit", "branch", "dirty_state"], "properties": {"commit": {"$ref": "#/$defs/sha256"}, "branch": {"$ref": "#/$defs/nonempty"}, "dirty_state": {"enum": ["clean", "dirty"]}, "dirty_patch_sha256": {"$ref": "#/$defs/sha256"}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "source_provenance"], "properties": {"path": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha256"}, "source_provenance": {"enum": ["RESOLVED", "UNKNOWN", "UNAVAILABLE"]}}},
    "models": {"type": "object", "additionalProperties": false, "required": ["agile_policy", "ra_value", "recovery_policy"], "properties": {"agile_policy": {"$ref": "#/$defs/model"}, "ra_value": {"$ref": "#/$defs/model"}, "recovery_policy": {"$ref": "#/$defs/model"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["mujoco_binary_path", "mujoco_binary_sha256", "mujoco_version", "timestep_s", "solver", "go2_mjcf_path", "go2_mjcf_sha256", "go2_assets_sha256", "hardware_mode"], "properties": {"mujoco_binary_path": {"$ref": "#/$defs/nonempty"}, "mujoco_binary_sha256": {"$ref": "#/$defs/sha256"}, "mujoco_version": {"$ref": "#/$defs/nonempty"}, "timestep_s": {"type": "number", "exclusiveMinimum": 0}, "solver": {"$ref": "#/$defs/nonempty"}, "go2_mjcf_path": {"$ref": "#/$defs/nonempty"}, "go2_mjcf_sha256": {"$ref": "#/$defs/sha256"}, "go2_assets_sha256": {"$ref": "#/$defs/sha256"}, "hardware_mode": {"const": "simulation"}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256", "metadata"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha256"}, "metadata": {"type": "object", "additionalProperties": false, "required": ["schema", "obstacle_count"], "properties": {"schema": {"$ref": "#/$defs/nonempty"}, "obstacle_count": {"type": "integer", "minimum": 0}}}}},
    "seeds": {"type": "object", "additionalProperties": false, "required": ["root_seed", "sources"], "properties": {"root_seed": {"type": "integer", "minimum": 0}, "sources": {"type": "object", "additionalProperties": false, "required": ["scene_generator", "controller_goal", "perception", "evaluator"], "properties": {"scene_generator": {"type": "integer", "minimum": 0}, "controller_goal": {"type": "integer", "minimum": 0}, "perception": {"type": "integer", "minimum": 0}, "evaluator": {"type": "integer", "minimum": 0}}}}},
    "perception": {"type": "object", "additionalProperties": false, "required": ["source", "version", "sha256", "frame_contract_version"], "properties": {"source": {"$ref": "#/$defs/nonempty"}, "version": {"$ref": "#/$defs/nonempty"}, "sha256": {"$ref": "#/$defs/sha256"}, "frame_contract_version": {"$ref": "#/$defs/nonempty"}}},
    "rates": {"type": "object", "additionalProperties": false, "required": ["controller", "pd", "policy", "ra", "perception"], "properties": {"controller": {"type": "number", "exclusiveMinimum": 0}, "pd": {"type": "number", "exclusiveMinimum": 0}, "policy": {"type": "number", "exclusiveMinimum": 0}, "ra": {"type": "number", "exclusiveMinimum": 0}, "perception": {"type": "number", "exclusiveMinimum": 0}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["arrival_region_m", "arrival_hold_s", "fall_height_m", "fall_angle_rad", "collision_definition_id", "ra_entry_threshold", "ra_exit_threshold"], "properties": {"arrival_region_m": {"type": "number", "exclusiveMinimum": 0}, "arrival_hold_s": {"type": "number", "exclusiveMinimum": 0}, "fall_height_m": {"type": "number", "minimum": 0}, "fall_angle_rad": {"type": "number", "exclusiveMinimum": 0}, "collision_definition_id": {"$ref": "#/$defs/nonempty"}, "ra_entry_threshold": {"type": "number"}, "ra_exit_threshold": {"type": "number"}}}
  },
  "x-abs-telemetry": {"required_scalar_columns": ["run_id", "sequence", "simulation_time_s", "monotonic_time_ns", "telemetry_fresh", "base_x_m", "base_y_m", "base_z_m", "roll_rad", "pitch_rad", "yaw_rad", "policy_state", "ra_value", "ra_entry_threshold", "ra_exit_threshold", "command_vx_mps", "command_vy_mps", "command_wz_rps", "actual_vx_mps", "actual_vy_mps", "actual_wz_rps", "recovery_vx_mps", "recovery_vy_mps", "recovery_wz_rps", "recovery_constraint_margin", "ray_valid", "ray_age_ns", "controller_active", "rl_active", "collision_available", "collision", "fall", "arrival_candidate"], "finite_scalar_columns": ["simulation_time_s", "monotonic_time_ns", "base_x_m", "base_y_m", "base_z_m", "roll_rad", "pitch_rad", "yaw_rad", "ra_value", "ra_entry_threshold", "ra_exit_threshold", "command_vx_mps", "command_vy_mps", "command_wz_rps", "actual_vx_mps", "actual_vy_mps", "actual_wz_rps", "recovery_vx_mps", "recovery_vy_mps", "recovery_wz_rps", "recovery_constraint_margin", "ray_age_ns"], "true_columns": ["telemetry_fresh", "ray_valid", "controller_active", "rl_active", "collision_available"], "vector_groups": [{"prefix": "ray_log2", "length": 11}, {"prefix": "action_raw", "length": 12}, {"prefix": "action_clipped", "length": 12}, {"prefix": "joint_target_rad", "length": 12}, {"prefix": "torque_nm", "length": 12}, {"prefix": "torque_saturated", "length": 12}]},
  "x-abs-events": {"required_fields": ["run_id", "sequence", "monotonic_time_ns", "simulation_time_s", "type"], "required_types": ["episode_start", "controller_active", "rl_entered", "valid_ready", "terminal", "shutdown"]},
  "x-abs-summary": {"required_fields": ["schema_version", "run_id", "validity", "terminal_outcome", "invalid_reasons", "metrics", "artifacts", "artifact_hashes"], "required_artifact_paths": {"manifest": "manifest.json", "telemetry": "telemetry.csv", "events": "events.jsonl"}}
}
