<?xml version="1.0" ?>
<mujoco model="go2 slope obstacle">
  <include file="go2.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- 6 degree uphill slope along +x. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" quat="0.99863 0 -0.052336 0"/>

    <!-- Sparse obstacles on the slope; not in the spawn clearance zone or initial corridor. -->
    <geom name="slope_box_left" type="box" pos="2.8 0.65 0.45" size="0.22 0.35 0.18"/>
    <geom name="slope_cylinder_right" type="cylinder" pos="4.2 -0.55 0.55" size="0.22 0.35"/>
  </worldbody>
</mujoco>
